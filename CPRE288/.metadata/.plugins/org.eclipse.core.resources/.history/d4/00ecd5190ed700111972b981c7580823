void interruptHandler() {
TIMER3_ICR_R |= 0x400;

if (edgeType == 0) {
    risingTimer = TIMER3_TBR_R;
    edgeType = 1;
}
else if (edgeType == 1){
    fallingTimer = TIMER3_TBR_R;
    pulseWidth = risingTimer - fallingTimer;
    pingFlag = 1;
    TIMER3_CTL_R &= ~0x100;
}
