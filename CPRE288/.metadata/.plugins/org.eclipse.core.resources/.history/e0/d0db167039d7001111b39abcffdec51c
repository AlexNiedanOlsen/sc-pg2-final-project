#if _PART2



int main(void) {
    timer_init();
    lcd_init();
    ping_init();
    IntMasterEnable();
    while(1) {
        int pulseWidth = ping_read();
        lcd_clear();

        if (pulseWidth >= 0) {
            pulseWidth &= 0x00FFFFFF;
            lcd_printf("Width: %d", pulseWidth);
        }

        timer_waitMillis(1000);
    }

}
#endif
