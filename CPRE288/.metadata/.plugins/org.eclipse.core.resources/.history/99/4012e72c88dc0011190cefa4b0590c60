#if _PART2



int main(void) {
    timer_init();
    lcd_init();
    ping_init();
    init_counter();
    IntMasterEnable();
    
    while(1) {
        int pulseWidth = ping_read();
        lcd_clear();

        if (pulseWidth >= 0) {
            lcd_printf("Width: %d\n  Error: %d", pulseWidth, error_flag);
        }

        timer_waitMillis(1000);
    }

}
#endif

#if _PART3
int main(void) {
    timer_init();
    lcd_init();
    ping_init();
    init_counter();
    IntMasterEnable();

    while(1) {
        lcd_clear();

        float value = get_ping_cm();

        lcd_printf("Distance(cm): %.1f\", value );

        timer_waitMillis(1000);
    }
}
